# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock
# ...except for the test-service binary workspace: its lock pins the
# exact drasi-lib / drasi-core versions compiled into the test-service
# binary, which the drasi_lib CI variant depends on for byte-identical
# reaction output (Sha256Determinism baselines).
!e2e-test-framework/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
**/.DS_Store

# AI plans files
.plans/